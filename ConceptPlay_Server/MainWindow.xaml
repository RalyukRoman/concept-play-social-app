<Window x:Class="ConceptPlay_Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ConceptPlay_Server"
        mc:Ignorable="d" Padding="25" Closed="Window_Closed"
        Title="MainWindow" Height="450" Width="800">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.3*" MaxWidth="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <ListBox x:Name="ListBoxClients"
                 Grid.Column="0" 
                 Margin="10" Padding="10"
                 Background="LightBlue" 
                 BorderBrush="DarkCyan"
                 BorderThickness="6"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">

            <TextBlock x:Name="TextBlockStatus"
                       Text="Status: OFF"
                       Foreground="DarkRed"
                       Margin="10 0 10 20"
                       FontSize="20"/>
            
            <Button x:Name="ButtonOn" 
                    Content="ON" Width="100"
                    Margin="10 5" Padding="5"
                    FontSize="20"
                    Click="ButtonClickHandler"/>
            
            <Button x:Name="ButtonOff"
                    Content="OFF" Width="100"
                    Margin="10 5" Padding="5"
                    FontSize="20"
                    Click="ButtonClickHandler"/>
        </ListBox>

        <ListBox ItemsSource="{Binding DbRequestsCollection}" 
                 Grid.Column="1" 
                 Margin="10" Padding="10"
                 BorderThickness="2.5"
                 BorderBrush="Black"
                 VirtualizingStackPanel.IsVirtualizing="True">
            
            <ListBox.ItemTemplate>
                <DataTemplate>
                    
                    <StackPanel Orientation="Horizontal" 
                                Margin="4">

                        <TextBlock Text="{Binding ActionType}" 
                                   FontWeight="Bold"/>

                        <TextBlock Text=" ----> " 
                                   Margin="10 0"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding Table}" 
                                   Foreground="Green"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text=" ID: " 
                                   Margin="20 0 2 0"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding Id}"
                                   FontWeight="SemiBold"/>
                        
                    </StackPanel>
                    
                </DataTemplate>
            </ListBox.ItemTemplate>
            
        </ListBox>
    </Grid>
    
</Window>
