<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BlurEffect x:Key="BlurLight"
                Radius="1"
                KernelType="Gaussian"
                RenderingBias="Performance"/>

    <BlurEffect x:Key="BlurMedium"
                Radius="5"
                KernelType="Gaussian"
                RenderingBias="Performance"/>

    <BlurEffect x:Key="BlurStrong"
                Radius="15"
                KernelType="Gaussian"
                RenderingBias="Performance"/>
</ResourceDictionary>