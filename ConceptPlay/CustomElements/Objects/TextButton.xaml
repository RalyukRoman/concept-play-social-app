<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:object="clr-namespace:ConceptPlay.CustomElements.Objects"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="object:TextButton">

        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="object:TextButton">

                    <TextBlock x:Name="textBlockBasic"
                               Text="{TemplateBinding Content}"
                               Foreground="{TemplateBinding Foreground}"
                               Cursor="{TemplateBinding Cursor}"
                               Background="Transparent"
                               Padding="0"/>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">

                            <Setter TargetName="textBlockBasic" 
                                    Property="Foreground" 
                                    Value="{Binding RelativeSource={RelativeSource TemplatedParent}, 
                                            Path=HoverForeground}"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">

                            <Setter TargetName="textBlockBasic" 
                                    Property="Cursor" Value="Hand"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>
        </Setter>

    </Style>

</ResourceDictionary>