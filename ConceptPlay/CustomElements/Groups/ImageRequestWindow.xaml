<UserControl x:Class="ConceptPlay.CustomElements.Groups.ImageRequestWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:object="clr-namespace:ConceptPlay.CustomElements.Objects"
             mc:Ignorable="d"
             HorizontalAlignment="Stretch" 
             VerticalAlignment="Stretch">

    <Border Background="White" 
            Padding="20 10" CornerRadius="15"
            Effect="{StaticResource LittleShadow}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Label Content="Upload image" 
                   Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   FontWeight="DemiBold" FontSize="20"/>

            <Grid Grid.Row="1" Grid.ColumnSpan="2"
                  Margin="0 0 0 10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TextBoxImagePath" Width="350"
                         Grid.Column="0"
                         FontSize="15"
                         Margin="0 5 0 10" Padding="3 5" 
                         TextChanged="TextChangedImagePathHandler"/>

                <TextBlock x:Name="PlaceholderTextImagePath" 
                           Text="Enter the image path..." 
                           Grid.Column="0"
                           Margin="5 10" FontSize="15"
                           Foreground="DimGray"
                           IsHitTestVisible="False"/>

                <Button x:Name="ButtonPath" Content="..."
                        Width="30" Grid.Column="1"
                        Margin="0,5,0,10" 
                        FontSize="15" 
                        Click="ButtonClickHandler"/>

            </Grid>

            <TextBlock x:Name="TextBlockStatus" Text=""
                       Grid.Row="2" Grid.ColumnSpan="2"
                       Foreground="DarkRed" Margin="0 0 0 10"
                       Visibility="Collapsed"/>

            <object:RoundedButton x:Name="ButtonOk" Content="Ok"
                                  Grid.Row="3" Grid.Column="0" 
                                  CornerRadius="5" Margin="0 0 20 0"
                                  Background="#f5f5f5" BorderBrush="#2e2e4d"
                                  Foreground="#2e2e4d"/>

            <object:RoundedButton x:Name="ButtonClose" Content="Close"
                                  Grid.Row="3" Grid.Column="1" 
                                  CornerRadius="5" Margin="20 0 0 0"
                                  Background="#f5f5f5" BorderBrush="#2e2e4d"
                                  Foreground="#2e2e4d"/>
        </Grid>
    </Border>
</UserControl>
