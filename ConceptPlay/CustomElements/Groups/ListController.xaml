<UserControl x:Class="ConceptPlay.CustomElements.Groups.ListController"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:object="clr-namespace:ConceptPlay.CustomElements.Objects"
             mc:Ignorable="d"
             d:DesignHeight="50">

    <StackPanel Margin="0 10"
                Orientation="Horizontal" 
                HorizontalAlignment="Center">

        <object:RoundedButton x:Name="ButtonPrevious" Content="&lt;" 
                              Width="30" FontSize="20"
                              Margin="4 0" CornerRadius="5"
                              Background="#F5F5F5" BorderBrush="#2e2e4d"
                              Foreground="#2e2e4d"/>

        <TextBlock x:Name="TextBlockPageNumber" Text="1 - 10"
                   FontSize="15" Margin="6 0"
                   VerticalAlignment="Center"/>

        <object:RoundedButton x:Name="ButtonNext" Content="&gt;" 
                              Width="30" FontSize="20"
                              Margin="4 0" CornerRadius="5"
                              Background="#F5F5F5" BorderBrush="#2e2e4d"
                              Foreground="#2e2e4d"/>
    </StackPanel>
</UserControl>
