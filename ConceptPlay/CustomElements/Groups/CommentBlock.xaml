<UserControl x:Class="ConceptPlay.CustomElements.Groups.CommentBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:object="clr-namespace:ConceptPlay.CustomElements.Objects"
             mc:Ignorable="d" x:Name="Root"
             HorizontalAlignment="Stretch"
             Width="Auto">

    <Border Background="White" 
            BorderBrush="LightGray"
            Padding="10 3"
            BorderThickness="0 1 0 0"
            HorizontalAlignment="Stretch">

        <Grid HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" 
                  HorizontalAlignment="Stretch">
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10*" x:Name="ColumnCommentator"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="BorderAvatar"
                        Grid.Column="0"
                        Width="17.5" Height="17.5"
                        CornerRadius="10" Margin="5 0 4 0"
                        Background="Transparent" 
                        BorderBrush="Transparent"
                        ClipToBounds="True"
                        Visibility="Collapsed">

                    <Image x:Name="ImageAvatar"
                           Stretch="UniformToFill"
                           Width="20" Height="20">

                        <Image.Clip>
                            <EllipseGeometry Center="8.75, 8.75" 
                                             RadiusX="10.5" RadiusY="10.5"/>
                        </Image.Clip>

                    </Image>

                </Border>

                <object:TextButton x:Name="ButtonCommentator" 
                                   Content="👤 --Commentator--" 
                                   Grid.Column="1"
                                   Foreground="Black" HoverForeground="#FF27489D"
                                   FontSize="13" Margin="5 5"
                                   HorizontalAlignment="Left" 
                                   VerticalAlignment="Center"
                                   Click="ButtonClickHandler"/>

                <object:TextButton x:Name="ButtonDelete" Content="🗑️"
                                   Grid.Column="2"
                                   Foreground="Black" HoverForeground="Red"
                                   FontSize="15" Margin="0 0 15 0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Click="ButtonClickHandler"/>

                <TextBlock x:Name="TextBlockCreateDate" 
                           Text="📅 --Create date--"
                           Grid.Column="3"
                           FontSize="13" Margin="15 5"
                           HorizontalAlignment="Right"/>
            </Grid>

            <TextBlock x:Name="TextBlockContent" 
                       Text="--Comment content--" 
                       Grid.Row="1"
                       FontSize="15" Margin="5 5 0 10"
                       TextWrapping="Wrap"/>

            <Grid Grid.Row="2" HorizontalAlignment="Left"
                  Margin="5 5 0 5">
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <object:GeometryCheckBox x:Name="CheckedBoxLike"
                                         Grid.Column="0" Content="--Likes--" 
                                         FontSize="13"
                                         GeometryBox="{StaticResource GeometryLike}"
                                         FillChecked="Blue" FillNotChecked="Gray"
                                         HorizontalAlignment="Left" 
                                         VerticalAlignment="Center" 
                                         Checked="CheckedChangedHandler" 
                                         Unchecked="CheckedChangedHandler"/>

                <object:GeometryCheckBox x:Name="CheckedBoxDislike"
                                         Grid.Column="2" Content="--Dislikes--" 
                                         FontSize="13" Margin="15 0 0 0"
                                         GeometryBox="{StaticResource GeometryDislike}"
                                         FillChecked="Blue" FillNotChecked="Gray"
                                         HorizontalAlignment="Left" 
                                         VerticalAlignment="Center" 
                                         Checked="CheckedChangedHandler" 
                                         Unchecked="CheckedChangedHandler"/>
            </Grid>

        </Grid>
    </Border>

</UserControl>
