<Window x:Class="ConceptPlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:group="clr-namespace:ConceptPlay.CustomElements.Groups"
        mc:Ignorable="d"
        Title="ConceptPlay" Background="#F5F5F5"
        Height="450" Width="900"
        MinHeight="400" MinWidth="830">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition MinHeight="50" MaxHeight="70"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>

        <group:TopPanel x:Name="TopPanel" Grid.Row="0"/>

        <Frame x:Name="MainFrame" Grid.Row="1"
               NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
