<Page x:Class="ConceptPlay.Pages.PageConcept"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:group="clr-namespace:ConceptPlay.CustomElements.Groups"
      xmlns:object="clr-namespace:ConceptPlay.CustomElements.Objects"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="850"
      Title="Concept" Background="#F5F5F5">

    <Border Height="Auto" Background="White" 
            Style="{StaticResource MaxHeightInTable}"
            Effect="{StaticResource CommonShadow}"
            Padding="20 10 20 20" Margin="25"
            CornerRadius="25" 
            VerticalAlignment="Stretch" 
            HorizontalAlignment="Stretch">

        <ScrollViewer VerticalScrollBarVisibility="Visible" 
                      Padding="0 0 20 0">
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TextBlockTitle" Text="--Title--"
                           Grid.Row="0"
                           Margin="0 5 0 15"
                           FontSize="30" FontWeight="DemiBold"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>

                <WrapPanel Grid.Row="1"
                           Margin="0 0 0 5"
                           HorizontalAlignment="Left" Cursor="">

                    <Border x:Name="BorderAvatar"
                            Grid.Column="0" Grid.Row="0"
                            Width="25" Height="25"
                            CornerRadius="10" Margin="0 0 10 0"
                            Background="Transparent" 
                            BorderBrush="Transparent"
                            ClipToBounds="True"
                            Visibility="Collapsed">

                        <Image x:Name="ImageAvatar"
                               Width="25" Height="25" 
                               Stretch="UniformToFill">

                            <Image.Clip>
                                <EllipseGeometry Center="12.5, 12.5" 
                                             RadiusX="15" RadiusY="15"/>
                            </Image.Clip>

                        </Image>
                    </Border>

                    <object:TextButton x:Name="ButtonAuthor" 
                                       Content="👤 --Author--"
                                       Foreground="Black"
                                       HoverForeground="#FF27489D"
                                       FontSize="20"
                                       VerticalAlignment="Center"
                                       Click="ButtonClickHandler"/>

                    <object:TextButton x:Name="ButtonEdit" Content="🛠️"
                                       Foreground="Black"
                                       HoverForeground="#FF27489D"
                                       FontSize="25" Margin="25 0 0 0"
                                       VerticalAlignment="Center"
                                       Click="ButtonClickHandler"/>

                </WrapPanel>

                <WrapPanel Grid.Row="2"
                           Margin="5 15 0 5"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom">

                    <TextBlock x:Name="TextBlockCreateDate" 
                               Text="📅 --Create date--"
                               FontSize="15"/>

                    <Rectangle Width="1" Height="20"
                               Fill="DarkSlateGray"
                               Margin="10 0"/>

                    <TextBlock x:Name="TextBlockChangeDate" 
                               Text="⚙️ --Change date--"
                               FontSize="15"/>
                </WrapPanel>

                <WrapPanel Grid.Row="2" Grid.Column="0" 
                           Margin="0 15 0 5"
                           HorizontalAlignment="Stretch" 
                           VerticalAlignment="Bottom">

                    <object:GeometryCheckBox x:Name="CheckedBoxLike" 
                                             Content="--Likes--" FontSize="15"
                                             GeometryBox="{StaticResource GeometryHeart}"
                                             FillChecked="Red" FillNotChecked="Gray"
                                             Checked="CheckedChangeHandler" 
                                             Unchecked="CheckedChangeHandler"/>

                    <TextBlock x:Name="TextBlockViews" 
                               Text="👁️ --Views--"
                               FontSize="15"
                               Margin="30 0 0 0"/>

                    <Rectangle Width="1" Height="15"
                               Fill="DarkSlateGray"
                               Margin="10 0"/>

                    <TextBlock x:Name="TextBlockComments" 
                               Text="💬 --Comments--"
                               FontSize="15"/>
                </WrapPanel>

                <ItemsControl x:Name="WrapPanelGenres" 
                              ItemsSource="{Binding GenresCollection}"
                              Grid.Row="3"
                              Margin="0 15 0 10">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <group:GenreBlock Margin="0 2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                </ItemsControl>

                <TextBlock x:Name="TextBlockDescription" Text="--Description--"
                            Grid.Row="4"
                            FontSize="15" TextWrapping="Wrap"
                            Margin="5 15 0 15"/>

                <ScrollViewer x:Name="ScrollViewerImages"
                              Height="100" Margin="0 10 0 0"
                              Grid.Row="5"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">

                    <StackPanel x:Name="StackPanelImages"
                                Orientation="Horizontal"/>
                </ScrollViewer>

                <Label Content="Comments"
                        Grid.Row="6"
                        FontSize="18" FontWeight="SemiBold"
                        Margin="10"/>

                <Rectangle Height="1" Fill="DarkSlateGray"
                           Grid.Row="7"
                           Margin="0 0 0 20"/>

                <Grid Grid.Row="8"
                      Margin="0 0 0 15">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TextBoxComment"
                             Grid.Column="0" FontSize="17" 
                             KeyDown="TextBoxKeyDownHandler"/>

                    <Button x:Name="ButtonComment" Content=">"
                            Width="20" Grid.Column="1"
                            Click="ButtonClickHandler"/>
                </Grid>

                <ListBox x:Name="ListBoxComments" MaxHeight="500"
                         Grid.Row="9"
                         Background="Transparent" BorderBrush="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False"
                         VirtualizingStackPanel.IsVirtualizing="True" 
                         VirtualizingStackPanel.VirtualizationMode="Recycling" 
                         ItemsSource="{Binding CommentIdsCollection}"
                         PreviewMouseWheel="PreviewMouseWheelHandler">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <group:CommentBlock CommentDeleted="CommentDeletedHandler"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <group:ListController x:Name="ListControllerComments"
                                      Grid.Row="10"
                                      CurrentPage="0" MaxPage="0" 
                                      PageChanged="PageChangedHandler"/>
            </Grid>
        </ScrollViewer>
    </Border>
</Page>
