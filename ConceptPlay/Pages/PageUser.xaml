<Page x:Class="ConceptPlay.Pages.PageUser"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:group="clr-namespace:ConceptPlay.CustomElements.Groups"
      xmlns:object="clr-namespace:ConceptPlay.CustomElements.Objects"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="850"
      Title="User" Background="#F5F5F5">

    <Border Height="Auto"
            Style="{StaticResource MaxHeightInTable}"
            Effect="{StaticResource CommonShadow}"
            Background="White" 
            Padding="20 10 20 20" Margin="25"
            CornerRadius="25" 
            VerticalAlignment="Stretch" 
            HorizontalAlignment="Stretch">
        <Grid>

            <ScrollViewer x:Name="ScrollViewerContent"
                          VerticalScrollBarVisibility="Visible" 
                          Padding="0 0 15 0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" x:Name="ColumnUsername"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <object:RoundedButton x:Name="ButtonUploadImage"
                                          Grid.Column="0" Grid.Row="0"
                                          Content="📷" CornerRadius="15"
                                          FontSize="17" Padding="12 5"
                                          Margin="0 0 10 0" Cursor="Hand"
                                          Background="#f5f5f5" BorderBrush="#2e2e4d"
                                          Foreground="#2e2e4d"/>

                    <Border x:Name="BorderAvatar"
                            Grid.Column="0" Grid.Row="0"
                            Width="35" Height="35"
                            CornerRadius="10" Margin="0 0 10 0"
                            Background="Transparent" 
                            BorderBrush="Transparent"
                            ClipToBounds="True"
                            Visibility="Collapsed">

                        <Image x:Name="ImageAvatar"
                               Width="35" Height="35" 
                               Stretch="UniformToFill"
                               MouseUp="MouseUpHandler">
                            
                            <Image.Clip>
                                <EllipseGeometry Center="17.5, 17.5" 
                                                 RadiusX="20" RadiusY="20"/>
                            </Image.Clip>
                            
                        </Image>

                    </Border>

                    <TextBlock x:Name="TextBlockUsername" 
                               Text="-- Username --"
                               Grid.Column="1" Grid.Row="0"
                               FontSize="25" FontWeight="DemiBold"
                               TextTrimming="CharacterEllipsis" 
                               TextWrapping="NoWrap"
                               Margin="5"
                               HorizontalAlignment="Stretch" 
                               VerticalAlignment="Center"/>

                    <object:TextButton x:Name="ButtonExit" Content="🚪"
                                       Grid.Row="0" Grid.Column="2"
                                       Foreground="Black"
                                       HoverForeground="Red"
                                       Margin="5 0" FontSize="25" 
                                       VerticalAlignment="Center"
                                       Click="ButtonClickHandler"/>

                    <object:TextButton x:Name="ButtonDelete" Content="🗑️"
                                       Grid.Row="0" Grid.Column="4"
                                       Foreground="Black"
                                       HoverForeground="Red"
                                       Margin="10 0" FontSize="20" 
                                       VerticalAlignment="Center"
                                       Click="ButtonClickHandler"/>

                    <TextBlock x:Name="TextBlockEmail" 
                               Text="✉️ -- Email --"
                               Grid.Column="3" Grid.Row="0"
                               FontSize="20" Margin="30 0 10 0"
                               TextTrimming="CharacterEllipsis" 
                               TextWrapping="NoWrap"
                               HorizontalAlignment="Right" 
                               VerticalAlignment="Center" Cursor=""/>

                    <TextBox x:Name="TextBoxDescription"
                             MinHeight="50"
                             Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" 
                             FontSize="15" TextWrapping="Wrap"
                             Margin="0 20 0 0" Padding="0 5"
                             TextChanged="TextChangedHandler"/>

                    <TextBlock x:Name="PlaceholderTextDescription" 
                               Text="Enter description..."
                               Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"
                               Margin="5 25" FontSize="15"
                               Foreground="DimGray"
                               IsHitTestVisible="False"
                               VerticalAlignment="Top"/>

                    <Button x:Name="ButtonSave" Content="Save change" 
                            Height="35" Margin="0 10 0 0" 
                            Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5"
                            FontSize="20" FontWeight="Bold"
                            Background="#2e2e4d" Foreground="White" 
                            BorderBrush="Transparent"
                            VerticalAlignment="Bottom"
                            Click="ButtonClickHandler"/>

                    <Label x:Name="LabelConcepts" 
                           Content="Concepts" 
                           Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5"
                           FontSize="25" FontWeight="DemiBold"
                           Margin="0 20 0 5"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>

                    <ListBox x:Name="ListBoxConcepts" MaxHeight="500"
                             Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="5"
                             Margin="0 5" Padding="3 10"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="False"
                             VirtualizingStackPanel.IsVirtualizing="True" 
                             VirtualizingStackPanel.VirtualizationMode="Recycling" 
                             ItemsSource="{Binding ConceptsCollection}"
                             SelectionChanged="SelectionChangedHandler"
                             PreviewMouseWheel="PreviewMouseWheelHandler">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <group:ConceptBlock/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <group:ListController x:Name="ListControllerConcepts"
                                          Grid.Column="0" Grid.Row="6" Grid.ColumnSpan="5"
                                          CurrentPage="1" MaxPage="1" 
                                          PageChanged="PageChangedHandler"/>
                </Grid>
        </ScrollViewer>

        <group:ImageRequestWindow x:Name="ImageWindow"
                                  Visibility="Collapsed"
                                  Submitted="SubmittedImageWindowHandler"
                                  Closed="ClosedImageWindowHandler"/>

        </Grid>
    </Border>
</Page>
