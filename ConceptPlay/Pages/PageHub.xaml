<Page x:Class="ConceptPlay.Pages.PageHub"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:group="clr-namespace:ConceptPlay.CustomElements.Groups"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="850"
      Title="Hub" Background="#F5F5F5">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="275" MaxWidth="350"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto" MinHeight="25"/>
        </Grid.RowDefinitions>

        <Border x:Name="BorderFilters" Height="Auto" Background="White" 
                Style="{StaticResource MaxHeightInTable}"
                Effect="{StaticResource CommonShadow}"
                Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                Padding="20 10 20 20" Margin="25"
                CornerRadius="25" 
                VerticalAlignment="Top" HorizontalAlignment="Stretch">

            <ScrollViewer VerticalScrollBarVisibility="Visible" 
                          Padding="0 0 20 0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Content="Filters"
                           Grid.Row="0" 
                           FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <Grid Grid.Row="1"
                          Margin="0 5 0 0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TextBoxConcept"
                                 Grid.Column="0"
                                 FontSize="17" KeyDown="TextBoxKeyDownHandler"/>

                        <Button x:Name="ButtonComment" Content=">"
                                Width="20"
                                Grid.Column="1" Click="ButtonClickHandler"/>
                    </Grid>

                    <Label Content="Sort:"
                           Grid.Row="2" 
                           FontSize="17" FontWeight="DemiBold"
                           Margin="0 10 0 0"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>

                    <StackPanel x:Name="RadioGroupSort" 
                                Grid.Row="3" 
                                Margin="0 5 0 0">

                        <RadioButton Content="By Title" GroupName="RadioGroupSort" 
                                     FontSize="15"
                                     Checked="RadioButtonCheckedHandler"/>

                        <RadioButton Content="By Views" GroupName="RadioGroupSort" 
                                     FontSize="15"
                                     Checked="RadioButtonCheckedHandler"/>

                        <RadioButton Content="By Likes" GroupName="RadioGroupSort" 
                                     FontSize="15"
                                     Checked="RadioButtonCheckedHandler"/>

                        <RadioButton Content="By Newest" GroupName="RadioGroupSort" 
                                     FontSize="15"
                                     Checked="RadioButtonCheckedHandler"/>

                        <RadioButton Content="By Oldest" GroupName="RadioGroupSort" 
                                     FontSize="15"
                                     Checked="RadioButtonCheckedHandler"/>
                    </StackPanel>

                    <Label Content="Genres:"
                           Grid.Row="4" 
                           FontSize="17" FontWeight="DemiBold"
                           Margin="0 10 0 0"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>

                    <ItemsControl x:Name="ItemsControlGenres"
                                  Grid.Row="5"
                                  Margin="0 5 0 0" 
                                  ItemsSource="{Binding GenresCollection}">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <group:GenreBlock Cursor="Hand" Margin="0 5 0 0"
                                                  MouseDown="GenreClickHandler"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel x:Name="WrapPanelGenres"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Border>

        <ListBox x:Name="ListBoxConcepts"
                 Grid.Column="1" Grid.Row="0" 
                 Background="Transparent" BorderBrush="Transparent"
                 Margin="20 25 20 0" Padding="0 0 10 0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="False"
                 VirtualizingStackPanel.IsVirtualizing="True" 
                 VirtualizingStackPanel.VirtualizationMode="Recycling" 
                 ItemsSource="{Binding ConceptsCollection}"
                 SelectionChanged="ListBoxSelectionChangedHandler">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <group:ConceptBlock/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <group:ListController x:Name="ListControllerConcepts"
                              Grid.Column="1" Grid.Row="1" 
                              CurrentPage="0" MaxPage="0"
                              PageChanged="PageChangedHandler"/>
    </Grid>
</Page>
