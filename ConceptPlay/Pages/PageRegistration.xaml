<Page x:Class="ConceptPlay.Pages.PageRegistration"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:object="clr-namespace:ConceptPlay.CustomElements.Objects"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="850"
      Title="Registration" Background="#F3F3F3">

    <Border Background="White" BorderBrush="#ddd" 
            Effect="{StaticResource LittleShadow}"
            Height="300" Width="350"
            Padding="20 5"
            BorderThickness="1" CornerRadius="10" 
            VerticalAlignment="Center" 
            HorizontalAlignment="Center">
            
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition Height="1.3*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Label Content="Registration" 
                   Grid.Row="0" Grid.ColumnSpan="2" 
                   FontSize="25" FontWeight="Bold" 
                   VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <object:RoundedButton x:Name="ButtonBack" Content="Back"
                                  Grid.Row="0" Grid.Column="0"
                                  Background="White" BorderBrush="#2e2e4d"
                                  Foreground="#2e2e4d"
                                  BorderThickness="1" CornerRadius="15"
                                  FontSize="15" Padding="15 5"
                                  HorizontalAlignment="Left" 
                                  VerticalAlignment="Center"/>

            <TextBlock Text="Username:" 
                       Grid.Row="1" Grid.Column="0" 
                       FontSize="17"
                       VerticalAlignment="Center"/>

            <TextBox x:Name="TextBoxUsername" Height="30"
                     Grid.Row="1" Grid.Column="1" 
                     VerticalContentAlignment="Center"/>

            <TextBlock Text="Email:" 
                       Grid.Row="2" Grid.Column="0" 
                       FontSize="17"
                       VerticalAlignment="Center"/>

            <TextBox x:Name="TextBoxEmail" Height="30"
                     Grid.Row="2" Grid.Column="1" 
                     VerticalContentAlignment="Center"/>

            <TextBlock Text="Password:" 
                       Grid.Row="3" Grid.Column="0"
                       FontSize="17"
                       VerticalAlignment="Center"/>

            <PasswordBox x:Name="PasswordBox" Height="30" 
                         Grid.Row="3" Grid.Column="1" 
                         VerticalContentAlignment="Center"/>

            <TextBlock Text="Confirm password:" 
                       Grid.Row="4" Grid.Column="0"
                       FontSize="17"
                       VerticalAlignment="Center"/>

            <PasswordBox x:Name="PasswordBoxConfirm" Height="30" 
                         Grid.Row="4" Grid.Column="1" 
                         VerticalContentAlignment="Center"/>

            <Button x:Name="ButtonCreate" 
                    Content="Create" Height="35" 
                    Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                    FontSize="20" FontWeight="Bold"
                    Background="#2e2e4d" Foreground="White" 
                    BorderBrush="Transparent" 
                    Click="ButtonClickHandler"/>
        </Grid>
    </Border>
</Page>
